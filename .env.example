# Copy to .env.local for local overrides; set the same keys on the Vercel
# project that serves dayworker.co. The Firebase block is for the site's
# sign-up form; everything else is for the email campaigns (/blast).

# Firebase web app settings, from the developer (public by design: they ship
# in the page). Built in at build time, so redeploy after changing them.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# ZIP -> map location for new profiles
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional overrides: profiles go to "production", welcome emails to "(default)"
# NEXT_PUBLIC_FIREBASE_PROFILE_DB=production
# NEXT_PUBLIC_FIREBASE_MAIL_DB=(default)
# Local testing only, never on Vercel: host of the Firebase emulators
# NEXT_PUBLIC_FIREBASE_EMULATOR=127.0.0.1

# Public URL of the site (links in emails point here)
SITE_URL=https://www.dayworker.co

# CAN-SPAM: physical postal address shown in every email. Live sending is blocked until set.
COMPANY_ADDRESS="Dayworker, Inc., 123 Example St, City, NY 10001"

# /blast sign-in + signing secrets (long random strings in production)
BLAST_PASSWORD=
APP_SECRET=
CRON_SECRET=

# Production database (Supabase or Neon free tier). Unset = local PGlite in .data/
DATABASE_URL=

# App Store Connect → Analytics → Campaigns → provider token (pt=)
APPLE_PROVIDER_TOKEN=

# Mailbox passwords (Purelymail app passwords). Names match each mailbox's "env var" field.
SMTP_PASS_SENDER1=

# Optional: free NYC Open Data app token, lifts rate limits
SOCRATA_APP_TOKEN=
